# ==== Reinos de Aventura - server.properties recomendado (6-10 jugadores) ====
motd=§6§lReinos de Aventura §r§7- dragones, mazmorras y magia
max-players=10
difficulty=normal
gamemode=survival
pvp=true
online-mode=true
white-list=true
enforce-whitelist=true
spawn-protection=0
# Necesario: volar en dragones, planeadores y habilidades hace que el servidor expulse jugadores si esta en false
allow-flight=true
# Rendimiento: 8 de vision y 6 de simulacion es el punto dulce para 6-10 jugadores con mods
view-distance=8
simulation-distance=6
entity-broadcast-range-percentage=80
network-compression-threshold=256
sync-chunk-writes=false
max-tick-time=-1
level-name=world
level-seed=
level-type=minecraft\:normal
generate-structures=true
enable-command-block=true
server-port=25565
